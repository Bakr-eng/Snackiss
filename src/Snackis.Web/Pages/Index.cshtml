@page
@model Snackis.Web.Pages.IndexModel
@{
    ViewData["Title"] = "Snackis";
}

<h1 class="mb-4">Snackis</h1>

<!-- parent kategorier -->
<div class="mb-4">
    <h5 class="text-muted mb-3">Välj kategori</h5>
    <div class="d-flex flex-wrap gap-2">
        @foreach (var cat in Model.ParentCategories)
        {
            var isActive = Model.SelectedParent?.Id == cat.Id;
            <a href="?parentId=@cat.Id"
               class="btn @(isActive ? "btn-primary" : "btn-outline-primary")">
                @cat.Name
                @if (cat.SubCategories.Any())
                {
                    <span class="badge bg-secondary ms-1">@cat.SubCategories.Count</span>
                }
            </a>
        }
    </div>
</div>

<!-- sub kategorier -->
@if (Model.SelectedParent != null)
{
    <div class="mb-4">
        <h6 class="text-muted mb-2"> Underkategorier i "@Model.SelectedParent.Name"</h6>
        <div class="d-flex flex-wrap gap-2">
            @foreach (var sub in Model.SelectedParent.SubCategories)
            {
                var isActive = Model.SelectedSub?.Id == sub.Id;
                <a href="?parentId=@Model.SelectedParent.Id&subId=@sub.Id"
                   class="btn btn-sm @(isActive ? "btn-success" : "btn-outline-success")">@sub.Name</a>
            }
            @if (!Model.SelectedParent.SubCategories.Any())
            {
                <span class="text-muted fst-italic">Inga underkategorier</span>
            }
        </div>
    </div>
}

<!-- inlägg -->
@if (Model.SelectedSub != null)
{
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h5 class="mb-0">Inlägg i "@Model.SelectedSub.Name"</h5>

        @if (User.Identity?.IsAuthenticated != true)
        {
            <p class="text-danger mt-2">
                Du behöver <a href="/Identity/Account/Login">logga in</a> eller
                <a href="/Identity/Account/Register">registrera dig</a> för att kunna skapa inlägg.
            </p>
        }

        @if (User.Identity?.IsAuthenticated == true && User.IsInRole("User"))
        {
            <a href="/CreatePost?categoryId=@Model.SelectedSub.Id&parentId=@Model.SelectedParent!.Id"
               class="btn btn-success btn-sm">
                + Nytt inlägg
            </a>
        }
    </div>

    @if (Model.Posts.Any())
    {
        <div class="list-group" style="max-width: 700px;">
            @foreach (var post in Model.Posts)
            {
                var coments = Model.ComentsByPost.ContainsKey(post.Id)
                    ? Model.ComentsByPost[post.Id]
                    : new List<Snackis.Domain.Entities.Coment>();

                var isOpen = Model.OpenPostId == post.Id;

                <div class="list-group-item mb-4 bg-light rounded shadow-sm p-3">

                    <!-- Inlägg header -->
                    <div class="d-flex justify-content-between align-items-start">
                        <h6 class="mb-1 fw-semibold">@post.Title</h6>
                        <small class="text-muted">@post.CreatedAt.ToString("yyyy-MM-dd HH:mm")</small>
                    </div>

                    @if (!string.IsNullOrEmpty(post.ImageUrl))
                    {
                        <img src="@post.ImageUrl" alt="Inläggsbild"
                             class="img-fluid rounded mt-2" style="max-height: 300px;" />
                    }

                    <p class="mb-2 text-muted small mt-1">@post.Content</p>

                    <!-- Kommentarknapp -->
                    @if (isOpen)
                    {
                        <a href="?parentId=@Model.ParentId&subId=@Model.SubId"
                           class="btn btn-sm btn-secondary">
                            💬 Dölj kommentarer (@coments.Count)
                        </a>
                    }
                    else
                    {
                        <a href="?parentId=@Model.ParentId&subId=@Model.SubId&openPostId=@post.Id"
                           class="btn btn-sm btn-outline-secondary">
                            💬 Kommentarer (@coments.Count)
                        </a>
                    }

                    <!-- Kommentarssektion (visas när isOpen) -->
                    @if (isOpen)
                    {
                        <div class="mt-3 border-top pt-3">

                            <!-- Befintliga kommentarer -->
                            @if (coments.Any())
                            {
                                <div class="mb-3">
                                    @foreach (var coment in coments)
                                    {
                                        <div class="d-flex gap-2 mb-2">
                                            <div class="bg-white border rounded px-3 py-2 w-100 small">
                                                <div class="d-flex justify-content-between mb-1">
                                                    <span class="fw-semibold text-secondary">@coment.UserId</span>
                                                    <span class="text-muted" style="font-size:0.75rem;">
                                                        @coment.CreatedAt.ToString("yyyy-MM-dd HH:mm")
                                                    </span>
                                                </div>
                                                <div>@coment.Content</div>
                                            </div>
                                        </div>
                                    }
                                </div>
                            }
                            else
                            {
                                <p class="text-muted fst-italic small mb-2">Inga kommentarer än. Bli den första!</p>
                            }

                            <!-- Skriv kommentar (endast inloggade) -->
                            @if (User.Identity?.IsAuthenticated == true)
                            {
                                <form method="post" asp-page-handler="AddComent">
                                    <input type="hidden" name="ParentId" value="@Model.ParentId" />
                                    <input type="hidden" name="SubId" value="@Model.SubId" />
                                    <input type="hidden" name="NewComentPostId" value="@post.Id" />
                                    <div class="input-group input-group-sm">
                                        <input type="text" name="NewComentContent" class="form-control" placeholder="Skriv en kommentar..." required maxlength="500" />
                                        <button type="submit" class="btn btn-primary">Skicka</button>
                                    </div>
                                </form>
                            }
                            else
                            {
                                <p class="text-muted small mb-0">
                                    <a href="/Identity/Account/Login">Logga in</a> för att kommentera.
                                </p>
                            }
                        </div>
                    }

                </div>
            }
        </div>
    }
    else
    {
        <p class="text-muted fst-italic">Inga inlägg i denna kategori ännu.</p>
    }
}
