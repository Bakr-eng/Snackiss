@page
@model Snackis.Web.Pages.CreatePostModel
@{
    ViewData["Title"] = "Nytt inlägg";
}

<div style="max-width: 600px;">
    <nav aria-label="breadcrumb" class="mb-3">
        <ol class="breadcrumb">
            <li class="breadcrumb-item"><a href="/">Hem</a></li>
            <li class="breadcrumb-item">
                <a href="/?parentId=@Model.ParentId">Tillbaka</a>
            </li>
            <li class="breadcrumb-item active">Nytt inlägg</li>
        </ol>
    </nav>

    <h4 class="mb-1">Nytt inlägg</h4>
    @if (Model.SubCategory != null)
    {
        <p class="text-muted mb-4">Kategori: <strong>@Model.SubCategory.Name</strong></p>
    }

    <form method="post">
        <input type="hidden" asp-for="CategoryId" />
        <input type="hidden" asp-for="ParentId" />

        <div class="mb-3">
            <label class="form-label">Titel</label>
            <input asp-for="Title" class="form-control" placeholder="Rubrik på ditt inlägg" required />
        </div>

        <div class="mb-3">
            <label class="form-label">Innehåll</label>
            <textarea asp-for="Content" class="form-control" rows="6"
                      placeholder="Skriv ditt inlägg här..." required></textarea>
        </div>

        <div class="d-flex gap-2">
            <button type="submit" class="btn btn-success">Publicera inlägg</button>
            <a href="/?parentId=@Model.ParentId&subId=@Model.CategoryId"
               class="btn btn-outline-secondary">Avbryt</a>
        </div>
    </form>
</div>
